[Unit]
Description=Infra Sync infrastructure to NetBox synchronization
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/infra-sync/current
ExecStartPre=/usr/bin/install -d -m 0750 /run/infra-sync
ExecStart=/opt/infra-sync/current/scripts/run-scheduled-sync.sh

User=root
Group=root

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/infra-sync

StandardOutput=journal
StandardError=journal
SyslogIdentifier=infra-netbox-sync
