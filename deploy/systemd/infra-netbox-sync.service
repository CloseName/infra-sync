[Unit]
Description=Infra Sync infrastructure to NetBox synchronization
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/infra-sync/src
ExecStartPre=/usr/bin/install -d -m 0750 /run/infra-sync
ExecStart=/usr/bin/flock -n /run/infra-sync/apply.lock /opt/infra-sync/run-full-sync-registry.sh

User=root
Group=root

NoNewPrivileges=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=infra-netbox-sync
